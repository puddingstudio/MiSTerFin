# Copy to .env_tunarr and fill in for your setup.
# This file is loaded from the current directory or any parent directory —
# run the scripts from anywhere inside tunarr_scripts/.

# Tunarr's own API — no authentication needed, this is the ONLY thing this
# toolkit talks to. Jellyfin credentials live inside Tunarr itself (Settings
# > Sources), not here — see README.md's Auth section for the one-time setup
# you do in Tunarr's own web UI before running these scripts.
TUNARR_HOST=http://192.168.1.20:8000
